# Koi Software — Hostinger Apache rules for the hand-uploaded static site.
# Pretty URLs are real folders (…/servicios/x/index.html). No rewrite to index.php.

Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → apex (keep path and query). HTTPS is forced in hPanel.
  RewriteCond %{HTTP_HOST} ^www\.koisoftware\.com$ [NC]
  RewriteRule ^ https://koisoftware.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Short cache for HTML; long cache for static assets (images, fonts, css, js)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|png|jpg|jpeg|gif|svg|ico|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
