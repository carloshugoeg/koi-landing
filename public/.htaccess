# Koi Software — Hostinger Apache rules for the hand-uploaded static site.
# Pretty URLs are real folders (…/servicios/x/index.html). No rewrite to index.php.

Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → apex (keep path and query)
  RewriteCond %{HTTP_HOST} ^www\.koisoftware\.com$ [NC]
  RewriteRule ^ https://koisoftware.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Short cache for HTML; long cache for versioned static assets
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|woff2|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
